FROM oven/bun:1.2.20 as base

FROM base as deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install

FROM base as builder
WORKDIR /app
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*
COPY package.json bun.lock ./
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN bun run build
