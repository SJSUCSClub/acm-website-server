{
	"name": "acm-website-server",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "NODE_ENV=development bun run --watch src/index.ts",
		"test": "bun test src/tests",
		"lint": "eslint .",
		"format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
		"format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"build": "bun build ./src/index.ts --outdir ./dist",
		"precommit": "bun lint && bun typecheck && bun test"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.738.0",
    "@aws-sdk/client-ses": "^3.787.0",
		"@aws-sdk/client-sqs": "^3.738.0",
		"@aws-sdk/client-sts": "^3.738.0",
		"@aws-sdk/s3-request-presigner": "^3.758.0",
		"@hono/zod-openapi": "^0.16.4",
		"@lucia-auth/adapter-drizzle": "^1.1.0",
		"@scalar/hono-api-reference": "^0.5.156",
		"arctic": "^1.9.2",
		"drizzle-orm": "^0.33.0",
		"drizzle-zod": "^0.5.1",
		"hono": "^4.6.6",
		"hono-pino": "^0.3.0",
		"lucia": "^3.2.2",
		"pg": "^8.13.1",
		"pino": "^9.5.0",
		"pino-pretty": "^11.3.0",
		"stoker": "^1.2.7"
	},
	"devDependencies": {
		"@aws-sdk/types": "^3.734.0",
		"@smithy/types": "^4.1.0",
		"@types/bun": "^1.1.12",
		"@types/pg": "^8.11.10",
		"@typescript-eslint/eslint-plugin": "^8.11.0",
		"@typescript-eslint/parser": "^8.11.0",
		"drizzle-kit": "^0.24.2",
		"eslint": "^9.13.0",
		"eslint-plugin-drizzle": "0.2.3",
		"prettier": "^3.2.5",
		"typescript": "5.5.3",
		"typescript-eslint": "^8.11.0"
	}
}